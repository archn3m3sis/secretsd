#compdef secrets secret
# zsh completion for the `secrets` platform.
#
# Completes subcommands, module names, LIVE credential key names, and profile
# names. Key names come from `secrets names`, which prints names only and never
# a value — so tab-completion cannot leak a secret into your shell history.
#
# Source of truth: agentic-configuration-layer/completions/_secrets
# Installed by symlink into ~/.local/share/zsh/completions (already on $fpath).

_secrets_keys() {
  local -a keys
  keys=(${(f)"$(secrets names 2>/dev/null)"})
  (( ${#keys} )) && _describe -t keys 'credential' keys
}

_secrets_profiles() {
  local -a profs
  profs=(${(f)"$(secrets profile list 2>/dev/null | awk 'NR>1 && NF {print $1}')"})
  (( ${#profs} )) && _describe -t profiles 'profile' profs
}

_secrets() {
  local -a modules commands
  modules=(
    'api:API credentials and tokens'
    'pii:personal identity records (local only)'
    'keys:SSH keys and key mapping'
    'auth:authentication method directory'
    'machines:host inventory and health'
    'certs:certificates and expiry'
    'env:projects, backups, serving channels'
    'dns:zones, records, Cloudflare'
    'logins:accounts, passwords, TOTP'
  )
  commands=(
    'add:add a credential (hidden input)'
    'rm:remove a credential'
    'run:run a command with secrets injected'
    'pick:fuzzy-find a credential, then act on it'
    'copy:copy a value to the clipboard (auto-clears)'
    'rotate:guided rotation with manifest context'
    'profile:named key bundles'
    'names:list key names (values never shown)'
    'check:verify this host can decrypt'
    'doctor:full health check'
    'manifest:scaffold or refresh CREDENTIALS.yaml'
    'expiring:credentials expiring soon'
    'edit:open the raw store in an editor'
    'logs:run-log housekeeping'
    'help:usage'
  )

  _arguments -C \
    '1: :->first' \
    '*:: :->rest'

  case $state in
    first)
      _describe -t modules  'module'  modules
      _describe -t commands 'command' commands
      ;;
    rest)
      case $words[1] in
        rm|remove|del|copy|rotate)
          if [[ $words[CURRENT] == --* ]]; then
            _values 'option' '--ttl[seconds before the clipboard clears]'
          else
            _secrets_keys
          fi
          ;;
        run)
          case $words[CURRENT-1] in
            --only) _secrets_keys ;;
            --profile) _secrets_profiles ;;
            --as) _secrets_keys ;;
            *)
              _alternative \
                'options:option:((--only\:"inject only these keys" --as\:"expose SRC under name DST" --profile\:"inject a named bundle" --\:"end of options, command follows"))' \
                'commands:command:_command_names -e'
              ;;
          esac
          ;;
        profile)
          if (( CURRENT == 2 )); then
            _values 'subcommand' 'list' 'show' 'add' 'rm'
          else
            _secrets_profiles
          fi
          ;;
        expiring) _values 'option' '--days[window in days]' ;;
        logs)     _values 'subcommand' 'prune' ;;
        *)        _default ;;
      esac
      ;;
  esac
}

_secrets "$@"
