# --- credential material: never commit, on any branch, ever -------------------
# These patterns exist so that publishing this repository cannot leak anything,
# even by accident. secretsd keeps its data OUTSIDE the code tree by default;
# this is the second line of defence, not the first.
secrets/
run-logs/
*.enc.env
*.enc.yaml
*.enc.json
*.dotenv
.env
.env.*
keys.txt
*.pem
*.key
id_rsa*
id_ecdsa*
id_ed25519*
.sops.yaml

# personal state some layouts put beside the code
CREDENTIALS.yaml
PROVENANCE.yaml
SESSIONS.yaml
PROJECTS.yaml
PKM.yaml
VAULTS.yaml
ROTATE-THESE.md
.posture-cache
.sessions-scan
archived-sessions/
merges/

# --- ordinary noise ----------------------------------------------------------
.DS_Store
*.swp
*.bak-*
