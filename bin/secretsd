#!/usr/bin/env bash
# secret / secrets — the front door to the personal credential + access platform.
#
# NINE MODULES, TWO STORAGE TIERS:
#   encrypted (SOPS+age)  api · pii · keys · certs · logins
#   directory (plain YAML) auth · machines · env · dns
# The directory tier holds NO secret values — only the map of what exists, where
# it lives, and how you authenticate to it. That means you can read your whole
# access topology without decrypting anything.
#
# INJECT, NEVER RETRIEVE. No subcommand prints a secret VALUE to stdout, so
# nothing lands in a transcript, log, or memory. The single deliberate exception
# is `copy`, which routes a value to the system clipboard and auto-clears it.
#
#   secrets                      the dashboard
#   secrets <module>             open a module (api, pii, keys, auth, machines,
#                                certs, env, dns, logins)
#
# API module / top level (unchanged, so existing scripts keep working):
#   secrets add [NAME]           add secret(s): hidden value, loops — no editor
#   secrets rm [NAME]            remove a key (fuzzy picker when NAME is omitted)
#   secrets edit                 open the store in a TERMINAL editor
#   secrets run -- <cmd> [args]  decrypt into <cmd>'s env, then run it
#   secrets names                list KEY NAMES that are set (values NEVER shown)
#   secrets check                verify this host can decrypt the store
#   secrets manifest             scaffold/refresh secrets/CREDENTIALS.yaml
#   secrets expiring [--days N]  credentials expiring within N days (default 14)
#
# New:
#   secrets pick                 fuzzy-find a key by name, then choose an action
#   secrets copy [NAME] [--ttl N] value -> clipboard only, auto-clears (default 45s)
#   secrets rotate [NAME]        guided rotation with manifest context + date stamp
#   secrets profile <sub>        named key bundles (list, show, add, rm)
#   secrets doctor               full health check — refuses to report a false all-clear
#   secrets logs prune [KEEP]    cap run-logs/ (default keep 400)
#
# 'run' also takes:
#   --only NAME[,NAME...]        inject ONLY these keys
#   --as   SRC=DST               expose store key SRC under the name DST
#   --profile NAME               inject exactly the keys in that profile
#
# bash 3.2-clean (macOS + Linux). Uses `gum` for the visual layer when present and
# attached to a terminal; degrades to plain prompts otherwise. Mutating commands
# self-log to run-logs/; read-only ones write no log at all.
set -uo pipefail

# --- resolve real script dir even through a symlink ---------------------------
SOURCE="$0"
while [ -h "$SOURCE" ]; do
  _d="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$_d/$SOURCE" ;; esac
done
SEC_BIN="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SEC_CODE="$(cd -P "$SEC_BIN/.." && pwd)"

# --- where the DATA lives -----------------------------------------------------
# Deliberately NOT "next to the code". Once this is installed from a repo, the
# program sits somewhere read-only and shared while your vault, manifest, logs
# and metadata are personal and must not be. Resolution order:
#
#   1  $SECRETSD_HOME                     explicit, wins over everything
#   2  ~/.config/secretsd/home            a path written once at setup
#   3  <code>/secrets exists              an in-tree layout, for development
#   4  ~/.local/share/secretsd            the default for a fresh install
if [ -n "${SECRETSD_HOME:-}" ]; then
  SEC_ROOT="$SECRETSD_HOME"
elif [ -f "$HOME/.config/secretsd/home" ]; then
  SEC_ROOT="$(sed -n '1p' "$HOME/.config/secretsd/home")"
  SEC_ROOT="${SEC_ROOT/#\~/$HOME}"
elif [ -d "$SEC_CODE/secrets" ]; then
  SEC_ROOT="$SEC_CODE"
else
  SEC_ROOT="$HOME/.local/share/secretsd"
fi
[ -d "$SEC_ROOT" ] || { mkdir -p "$SEC_ROOT/secrets" && chmod 700 "$SEC_ROOT" "$SEC_ROOT/secrets"; }
export SEC_ROOT SEC_CODE

# The program refers to itself when it needs to inject a credential into a child
# (DNS calls, YubiKey seed moves, scoped launches). Resolve that ONCE from the
# real invocation instead of hardcoding a filename that renames break.
SEC_SELF="$SOURCE"
export SEC_SELF

. "$SEC_BIN/lib/ui.sh"
. "$SEC_BIN/lib/store.sh"
. "$SEC_BIN/lib/tui.sh"
. "$SEC_BIN/lib/vault.sh"
. "$SEC_BIN/lib/pkm.sh"
. "$SEC_BIN/lib/inbox.sh"
. "$SEC_BIN/lib/workspace.sh"
. "$SEC_BIN/lib/security.sh"
. "$SEC_BIN/lib/modkeys.sh"
. "$SEC_BIN/lib/posture.sh"
. "$SEC_BIN/lib/modcerts.sh"
. "$SEC_BIN/lib/modmachines.sh"
. "$SEC_BIN/lib/record.sh"
. "$SEC_BIN/lib/moddns.sh"
. "$SEC_BIN/lib/gen.sh"
. "$SEC_BIN/lib/palette.sh"
. "$SEC_BIN/lib/modyubikey.sh"
. "$SEC_BIN/lib/audit.sh"
. "$SEC_BIN/lib/import.sh"
. "$SEC_BIN/lib/broker.sh"
. "$SEC_BIN/lib/profiles.sh"
. "$SEC_BIN/lib/recovery.sh"
. "$SEC_BIN/lib/guard.sh"
. "$SEC_BIN/lib/monitor.sh"

SEC_PROFILES="$SEC_SECRETS/PROFILES.yaml"

TMPD="$(mktemp -d "${TMPDIR:-/tmp}/secret.XXXXXX")"
chmod 700 "$TMPD"
cleanup() { sec_clip_scrub 2>/dev/null; [ -n "${TMPD:-}" ] && rm -rf "$TMPD"; }
trap cleanup EXIT INT TERM

sec_help() { grep -E '^#( |$)' "$SOURCE" | sed 's/^# \{0,1\}//' | sed -n '2,52p'; }


# =============================================================================
# VAULT SCREEN — choose the encrypted database before anything else
# =============================================================================
vault_screen() {
  if ! ui_interactive; then sec_help; return 0; fi
  local -a V_PATH V_NAME V_COUNT V_DOT V_DLAB V_DESC V_MARK V_HUE V_LINE
  local n=0 p nm cnt rec hosts

  while IFS= read -r p; do
    [ -n "$p" ] || continue
    nm="$(vault_name "$p")"
    rec="$(sec_file_recipients "$p" | sec_nlines)"
    if vault_can_decrypt "$p"; then
      cnt="$(sec_names "$p" | sec_nlines)"
      V_COUNT[$n]="$cnt keys"; V_DOT[$n]="ok"; V_DLAB[$n]="open · $rec recipients"
      V_MARK[$n]="⣿⣿⣿"; V_HUE[$n]="$N_CYAN"
    else
      V_COUNT[$n]="locked"; V_DOT[$n]="err"; V_DLAB[$n]="no key here · $rec recipients"
      V_MARK[$n]="⣿⡇⣿"; V_HUE[$n]="$T_DIM"
    fi
    hosts="$(vault_recipient_hosts "$p" | tr '\n' ' ')"
    V_PATH[$n]="$p"; V_NAME[$n]="$nm"
    V_DESC[$n]="$(tui_fit "$(vault_size "$p") · modified $(vault_mtime "$p") · ${hosts:-unknown hosts}" $(( TUI_COLS - 12 )))"
    n=$(( n + 1 ))
  done <<EOF
$(vault_paths)
EOF

  if [ "$n" -eq 0 ]; then
    tui_page "NO VAULTS" "nothing encrypted found under secrets/"
    ui_note "create one to get started"
    ui_pause
    vault_create
    return 0
  fi

  local sel=0 key mode block gapn padrows extra i g curline prev
  local lastcols=0 lastrows=0 host sub
  host="$(hostname -s 2>/dev/null || echo host)"
  sub="secrets companion for agentic workflows and PKM vaults · $n database(s)"

  draw_vault() {
    local k="$1" on="$2"
    printf '\033[%d;1H' "${V_LINE[$k]}"
    tui_modrow "$on" "${V_MARK[$k]}" "${V_HUE[$k]}" "${V_NAME[$k]}" \
               "${V_COUNT[$k]}" "${V_DOT[$k]}" "${V_DLAB[$k]}"
    [ "$mode" != compact ] && tui_moddesc "$on" "${V_DESC[$k]}"
  }

  draw_vaults() {
    tui_home
    tui_header "$host" "$sub"
    curline=4
    i=0
    while [ "$i" -lt "$n" ]; do
      V_LINE[$i]="$(( curline + 1 ))"
      draw_vault "$i" "$([ "$i" = "$sel" ] && echo 1 || echo 0)"
      curline=$(( curline + 1 ))
      [ "$mode" != compact ] && curline=$(( curline + 1 ))
      if [ "$i" -lt $(( n - 1 )) ]; then
        g=0; while [ "$g" -lt "$gapn" ]; do tui_blank; curline=$(( curline + 1 )); g=$(( g + 1 )); done
        if [ "$i" -lt "$extra" ]; then tui_blank; curline=$(( curline + 1 )); fi
      fi
      i=$(( i + 1 ))
    done
    g=0; while [ "$g" -lt "$padrows" ]; do tui_blank; g=$(( g + 1 )); done
    tui_footer "↵ open" "n new" "e encryption" "b backup" "i inbox" "w workspace" "q quit"
    tui_clear_below
  }

  vlayout() {
    local avail; avail=$(( TUI_ROWS - 6 ))
    if [ $(( n * 2 )) -le "$avail" ]; then mode=normal; block=$(( n * 2 ))
    else mode=compact; block=$n; fi
    gapn=0
    if [ "$n" -gt 1 ]; then
      gapn=$(( (avail - block) / (n - 1) )); [ "$gapn" -lt 0 ] && gapn=0; [ "$gapn" -gt 3 ] && gapn=3
    fi
    padrows=$(( avail - block - gapn * (n - 1) )); [ "$padrows" -lt 0 ] && padrows=0
    extra=0
    if [ "$n" -gt 1 ] && [ "$padrows" -gt 0 ] && [ "$padrows" -lt "$n" ]; then extra="$padrows"; padrows=0; fi
  }

  tui_begin
  trap 'tui_end; cleanup' EXIT INT TERM
  tui_dims; vlayout; draw_vaults
  lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"

  while :; do
    key="$(tui_readkey)" || break
    prev="$sel"
    case "$key" in
      up)   sel=$(( sel - 1 )); [ "$sel" -lt 0 ] && sel=$(( n - 1 )) ;;
      down) sel=$(( sel + 1 )); [ "$sel" -ge "$n" ] && sel=0 ;;
      enter|right)
            if vault_can_decrypt "${V_PATH[$sel]}"; then
              SEC_STORE="${V_PATH[$sel]}"
              tui_end; dashboard; tui_begin
            else
              tui_end
              ui_err "this host holds no key for ${V_NAME[$sel]} — it cannot be opened here"
              ui_note "that is the trust boundary working, not a fault"
              ui_pause; tui_begin
            fi
            tui_dims; vlayout; draw_vaults; continue ;;
      char:n) tui_end; vault_create; tui_begin; tui_dims; vlayout; draw_vaults; continue ;;
      char:e) tui_end; vault_encryption "${V_PATH[$sel]}"; tui_begin; tui_dims; vlayout; draw_vaults; continue ;;
      char:b) tui_end; vault_backup_panel "${V_PATH[$sel]}"; tui_begin; tui_dims; vlayout; draw_vaults; continue ;;
      char:i) tui_end; inbox_screen; tui_begin; tui_dims; vlayout; draw_vaults; continue ;;
      char:w) tui_end; ws_screen; tui_begin; tui_dims; vlayout; draw_vaults; continue ;;
      quit|esc) break ;;
      *) continue ;;
    esac
    tui_dims
    if [ "$TUI_COLS" != "$lastcols" ] || [ "$TUI_ROWS" != "$lastrows" ]; then
      vlayout; draw_vaults; lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"
    else
      draw_vault "$prev" 0; draw_vault "$sel" 1
    fi
  done
  tui_end
  trap 'cleanup' EXIT INT TERM
  return 0
}

# =============================================================================
# DASHBOARD
# =============================================================================
mod_stat() { # $1 id -> "count|dotstate|dotlabel"
  local id="$1" state store n
  state="$(sec_module_state "$id")"
  store="$(sec_module_store "$id")"
  if [ "$state" != "built" ]; then printf '—|none|planned'; return; fi
  case "$id" in
    api)
      n="$(sec_count "$SEC_STORE" 2>/dev/null)"; n="${n:-0}"
      local undoc
      sec_manifest_keys > "$TMPD/mk" 2>/dev/null; sec_names > "$TMPD/sk" 2>/dev/null
      undoc="$(comm -23 "$TMPD/sk" "$TMPD/mk" 2>/dev/null | sec_nlines)"
      if [ "${undoc:-0}" -gt 0 ]; then printf '%s keys|warn|%s undocumented' "$n" "$undoc"
      else printf '%s keys|ok|healthy' "$n"; fi
      ;;
    *) printf '—|none|planned' ;;
  esac
}

dashboard() {
  if ! ui_interactive; then sec_help; return 0; fi

  # ---- gather EVERYTHING up front -----------------------------------------
  # Nothing in the redraw path may fork. A subshell per row per keypress is what
  # made moving between items tear the whole screen.
  local -a M_ID M_LABEL M_COUNT M_DOT M_DLAB M_DESC M_GLYPH M_HUE M_LINE
  local id icon label tier store state st n=0
  while IFS='|' read -r id icon label tier store state; do
    [ -n "$id" ] || continue
    st="$(mod_stat "$id")"
    M_ID[$n]="$id"
    M_LABEL[$n]="$label"
    M_COUNT[$n]="${st%%|*}"; st="${st#*|}"
    M_DOT[$n]="${st%%|*}"
    M_DLAB[$n]="${st#*|}"
    M_DESC[$n]="$(sec_module_desc "$id")"
    M_GLYPH[$n]="$(tui_glyph "$id")"
    M_HUE[$n]="$(tui_hue "$id")"
    n=$(( n + 1 ))
  done <<EOF
$(sec_modules)
EOF
  [ "$n" -gt 0 ] || { ui_err "no modules registered"; return 1; }

  local host total documented pending statline
  host="$(hostname -s 2>/dev/null || echo host)"
  total="$(sec_count 2>/dev/null)"; total="${total:-0}"
  sec_manifest_keys > "$TMPD/dmk" 2>/dev/null; sec_names > "$TMPD/dsk" 2>/dev/null
  documented="$(comm -12 "$TMPD/dsk" "$TMPD/dmk" 2>/dev/null | sec_nlines)"
  pending=0
  [ -f "$SEC_ROTATE" ] && pending="$(grep '^- \[ \]' "$SEC_ROTATE" 2>/dev/null | sec_nlines)"
  if [ "${pending:-0}" -gt 0 ]; then
    statline="$total credentials · $documented documented · $pending pending rotation"
  else
    statline="$total credentials · $documented documented · nothing pending"
  fi

  local sel=0 key mode block gapn padrows extra i g curline
  local lastcols=0 lastrows=0 wavedir="" prev=0
  local sel_lcol=0 sel_llen=0

  # ---- draw one module (row + description) at its recorded line ------------
  draw_module() {                     # $1 index  $2 selected(0/1)
    local k="$1" on="$2"
    printf '\033[%d;1H' "${M_LINE[$k]}"
    tui_modrow "$on" "${M_GLYPH[$k]}" "${M_HUE[$k]}" "${M_LABEL[$k]}" \
               "${M_COUNT[$k]}" "${M_DOT[$k]}" "${M_DLAB[$k]}"
    [ "$mode" != compact ] && tui_moddesc "$on" "${M_DESC[$k]}"
    if [ "$on" = "1" ]; then sel_lcol="$TUI_LEAD_COL"; sel_llen="$TUI_LEAD_LEN"; fi
  }

  # ---- full repaint (first draw, resize, or returning from a module) -------
  draw_all() {
    tui_home
    tui_header "$host" "$statline"
    curline=4
    i=0
    while [ "$i" -lt "$n" ]; do
      M_LINE[$i]="$(( curline + 1 ))"
      draw_module "$i" "$([ "$i" = "$sel" ] && echo 1 || echo 0)"
      curline=$(( curline + 1 ))
      [ "$mode" != compact ] && curline=$(( curline + 1 ))
      if [ "$i" -lt $(( n - 1 )) ]; then
        g=0; while [ "$g" -lt "$gapn" ]; do tui_blank; curline=$(( curline + 1 )); g=$(( g + 1 )); done
        if [ "$i" -lt "$extra" ]; then tui_blank; curline=$(( curline + 1 )); fi
      fi
      i=$(( i + 1 ))
    done
    g=0; while [ "$g" -lt "$padrows" ]; do tui_blank; g=$(( g + 1 )); done
    tui_footer "↑↓ move" "↵ open" "/ search" "d doctor" "r rotations" "q quit"
    tui_clear_below
  }

  layout() {
    local avail
    avail=$(( TUI_ROWS - 6 ))
    if [ $(( n * 2 )) -le "$avail" ]; then mode=normal; block=$(( n * 2 ))
    else                                   mode=compact; block=$n
    fi
    gapn=0
    if [ "$n" -gt 1 ]; then
      gapn=$(( (avail - block) / (n - 1) ))
      [ "$gapn" -lt 0 ] && gapn=0
      [ "$gapn" -gt 3 ] && gapn=3
    fi
    padrows=$(( avail - block - gapn * (n - 1) ))
    [ "$padrows" -lt 0 ] && padrows=0
    extra=0
    if [ "$n" -gt 1 ] && [ "$padrows" -gt 0 ] && [ "$padrows" -lt "$n" ]; then
      extra="$padrows"; padrows=0
    fi
  }

  tui_begin
  trap 'tui_end; cleanup' EXIT INT TERM
  tui_dims; layout; draw_all
  lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"

  while :; do
    key="$(tui_readkey)" || break
    prev="$sel"

    case "$key" in
      up)     sel=$(( sel - 1 )); [ "$sel" -lt 0 ] && sel=$(( n - 1 )); wavedir="up" ;;
      down)   sel=$(( sel + 1 )); [ "$sel" -ge "$n" ] && sel=0;         wavedir="down" ;;
      enter|right)
              tui_end; module_open "${M_ID[$sel]}"; tui_begin
              tui_dims; layout; draw_all
              lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"; continue ;;
      search) tui_end
              local picked; picked="$(api_pick)" || true
              [ -n "${picked:-}" ] && key_actions "$picked"
              tui_begin; tui_dims; layout; draw_all
              lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"; continue ;;
      char:d) tui_end; do_doctor; ui_pause; tui_begin
              tui_dims; layout; draw_all
              lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"; continue ;;
      char:r) tui_end
              if [ -f "$SEC_ROTATE" ]; then
                tui_page "PENDING ROTATION" "$pending credential(s) recorded as exposed"
                grep '^- \[' "$SEC_ROTATE" | sed 's/^/   /'
                ui_pause
              fi
              tui_begin; tui_dims; layout; draw_all
              lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"; continue ;;
      quit|esc) break ;;
      *)      continue ;;
    esac

    # a resize invalidates every recorded line: repaint in full
    tui_dims
    if [ "$TUI_COLS" != "$lastcols" ] || [ "$TUI_ROWS" != "$lastrows" ]; then
      layout; draw_all
      lastcols="$TUI_COLS"; lastrows="$TUI_ROWS"
    else
      # ONLY the two rows that changed. No full repaint, so no flicker.
      draw_module "$prev" 0
      draw_module "$sel"  1
    fi

    if [ -n "$wavedir" ] && [ "${sel_llen:-0}" -gt 0 ]; then
      if ! read -t 0 </dev/tty 2>/dev/null; then
        tui_wave "${M_LINE[$sel]}" "$sel_lcol" "$sel_llen" "$wavedir" 1
      fi
      wavedir=""
    fi
  done

  tui_end
  trap 'cleanup' EXIT INT TERM
  return 0
}

module_open() {
  local id="$1"
  if [ "$(sec_module_state "$id")" != "built" ]; then
    module_preview "$id"
    return 0
  fi
  case "$id" in
    api)      api_menu ;;
    keys)     keys_screen ;;
    certs)    certs_screen ;;
    machines) machines_screen ;;
    auth)     auth_screen ;;
    env)      env_screen ;;
    logins)   logins_screen ;;
    pii)      pii_screen ;;
    dns)      dns_screen ;;
    *)    ui_err "no handler for module '$id'" ;;
  esac
}

# module_preview ID — the screen a module shows before it is implemented.
# It reports its real storage state and the capabilities it will carry, in the
# same visual language as everything else. It never fabricates counts.
module_preview() {
  local id="$1" store tier label glyph hue exists rec caps line n=0 i key
  store="$(sec_module_store "$id")"
  tier="$(sec_module_field "$id" 4)"
  label="$(sec_module_label "$id")"
  glyph="$(tui_glyph "$id")"
  hue="$(tui_hue "$id")"

  if [ -f "$store" ]; then
    exists="present"
    rec="$(sec_file_recipients "$store" | sec_nlines) recipient(s)"
  else
    exists="not created yet"
    rec="—"
  fi

  tui_begin
  trap 'tui_end; cleanup' EXIT INT TERM
  while :; do
    tui_dims
    tui_home
    tui_blank
    printf '  %s%s%s  %s%s%s%s' "$hue" "$glyph" "$T_RS" "$T_B" "$T_TEXT" "$(printf '%s' "$label" | tr '[:lower:]' '[:upper:]')" "$T_RS"
    tui_padn "$TUI_COLS" $(( 2 + 3 + 2 + ${#label} )); printf '\n'
    printf '  %s%s%s' "$T_DIM" "$(sec_module_desc "$id")" "$T_RS"
    tui_padn "$TUI_COLS" $(( 2 + $(printf '%s' "$(sec_module_desc "$id")" | wc -c | tr -d ' ') )); printf '\n'
    tui_hrule

    tui_blank
    printf '  %sSTORAGE%s' "$T_B$T_ACCENT" "$T_RS"; tui_padn "$TUI_COLS" 9; printf '\n'
    tui_blank
    local rows="tier|$tier ($([ "$tier" = enc ] && echo 'SOPS + age encrypted' || echo 'plaintext directory, no secret values'))
path|${store#$SEC_ROOT/}
state|$exists
keyed to|$rec"
    while IFS='|' read -r k v; do
      [ -n "$k" ] || continue
      printf '    %s%-12s%s %s%s%s' "$T_MUTE" "$k" "$T_RS" "$T_TEXT" "$v" "$T_RS"
      tui_padn "$TUI_COLS" $(( 4 + 12 + 1 + ${#v} )); printf '\n'
    done <<CAPS
$rows
CAPS

    tui_blank
    printf '  %sWILL CARRY%s' "$T_B$T_ACCENT" "$T_RS"; tui_padn "$TUI_COLS" 12; printf '\n'
    tui_blank
    n=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '    %s·%s %s%s%s' "$hue" "$T_RS" "$T_MUTE" "$line" "$T_RS"
      tui_padn "$TUI_COLS" $(( 4 + 2 + ${#line} )); printf '\n'
      n=$(( n + 1 ))
    done <<CAPS
$(sec_module_caps "$id")
CAPS

    local used=$(( 4 + 1 + 1 + 1 + 4 + 1 + 1 + 1 + n + 2 ))
    local pad=$(( TUI_ROWS - used - 1 )); [ "$pad" -lt 0 ] && pad=0
    i=0; while [ "$i" -lt "$pad" ]; do tui_blank; i=$(( i + 1 )); done
    tui_footer "esc back" "q quit"
    tui_clear_below

    key="$(tui_readkey)" || break
    case "$key" in quit|esc|left) break ;; *) continue ;; esac
  done
  tui_end
  trap 'cleanup' EXIT INT TERM
  return 0
}

# =============================================================================
# API MODULE
# =============================================================================
api_add_one() { # $1 optional name -> 0 saved, 1 skipped, 2 cancelled
  local name val
  if [ -n "${1:-}" ]; then name="$1"; else name="$(ui_ask 'Key name' 'e.g. STRIPE_API_KEY')" || return 2; fi
  [ -n "$name" ] || { ui_warn "no name given"; return 1; }
  sec_valid_name "$name" || { ui_err "invalid name '$name' — letters, digits, underscore; no leading digit"; return 1; }
  if sec_has "$name"; then ui_confirm "'$name' already exists — overwrite it?" || { ui_info "left '$name' unchanged"; return 1; }; fi
  val="$(ui_ask_secret "Value for $name")" || return 2
  [ -n "$val" ] || { ui_warn "empty value — not saved"; return 1; }
  sec_log "add $name"
  if sec_put "$name" "$val"; then unset val; ui_ok "saved '$name'"; return 0
  else unset val; ui_err "failed to save '$name' — see $SEC_LOG"; return 1; fi
}

api_add_loop() {
  sec_log_start "add"
  ui_rule "Add credentials"
  ui_info "Input is hidden and never printed back."
  local added=0 r
  while :; do
    api_add_one; r=$?
    [ "$r" -eq 0 ] && added=$((added + 1))
    [ "$r" -eq 2 ] && break
    ui_confirm "Add another?" || break
  done
  if [ "$added" -gt 0 ]; then ui_ok "$added added. Store now holds $(sec_count) keys."
  else ui_info "Nothing added."; fi
}

api_edit() {
  sec_log_start "edit"
  local ed="${SECRET_EDITOR:-}" c
  if [ -z "$ed" ]; then for c in nvim vim nano vi; do command -v "$c" >/dev/null 2>&1 && { ed="$c"; break; }; done; fi
  [ -n "$ed" ] || { ui_err "no terminal editor found (tried nvim/vim/nano/vi); set SECRET_EDITOR"; return 1; }
  sec_log "edit using $ed"
  EDITOR="$ed" VISUAL="$ed" sops "$SEC_STORE"
}

api_check() {
  local v
  v="$(sops exec-env "$SEC_STORE" 'printf %s "${SOPS_SELFTEST:-}"' 2>/dev/null)"
  if [ "$v" = "ok" ]; then ui_ok "store decrypts OK on $(hostname -s)"; return 0
  else ui_err "store did NOT decrypt on $(hostname -s) — check the age key"; return 1; fi
}

# --- browse: names annotated with manifest context ----------------------------
api_rows() {
  local n prov used exp
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    prov="$(sec_manifest_field "$n" provider)"; [ -z "$prov" ] || [ "$prov" = "TODO" ] && prov="—"
    exp="$(sec_manifest_field "$n" expires)";  [ -z "$exp" ] && exp="—"
    printf '%-38s %-18s %s\n' "$n" "$prov" "$exp"
  done <<EOF
$(sec_names)
EOF
}

api_pick() { # echo one key name chosen by fuzzy filter
  api_rows | ui_filter "key name · provider · expires" | awk '{print $1}'
}

api_browse() {
  ui_rule "Credentials ($(sec_count))"
  printf '  %-38s %-18s %s\n' "NAME" "PROVIDER" "EXPIRES"
  api_rows | sed 's/^/  /'
}

# --- clipboard with auto-clear -------------------------------------------------
api_copy() {
  local name="${1:-}" ttl="${2:-45}"
  [ -n "$name" ] || name="$(api_pick)" || return 1
  [ -n "$name" ] || return 1
  sec_has "$name" || { ui_err "no such key: '$name'"; return 1; }

  local clip_put clip_get
  case "$(uname -s)" in
    Darwin) clip_put="pbcopy"; clip_get="pbpaste" ;;
    *)
      if command -v wl-copy >/dev/null 2>&1; then clip_put="wl-copy"; clip_get="wl-paste"
      elif command -v xclip >/dev/null 2>&1; then clip_put="xclip -selection clipboard"; clip_get="xclip -selection clipboard -o"
      else ui_err "no clipboard tool found (need pbcopy, wl-copy, or xclip)"; return 1; fi ;;
  esac

  # The value is materialised ONLY inside the sops child, piped straight to the
  # clipboard. What comes back to this shell is a SHA-256 of it, never the value —
  # the hash is only used to check the clipboard still holds our value before
  # clearing, so we never stomp something you copied afterwards.
  cat > "$TMPD/copy.sh" <<'INNER'
v="$(eval "printf '%s' \"\${$SEC_COPY_NAME}\"")"
[ -n "$v" ] || { echo "EMPTY" >&2; exit 1; }
printf '%s' "$v" | $SEC_CLIP_PUT
printf '%s' "$v" | shasum -a 256 | cut -d' ' -f1
INNER

  local h
  h="$(SEC_COPY_NAME="$name" SEC_CLIP_PUT="$clip_put" \
       sops exec-env "$SEC_STORE" "bash $TMPD/copy.sh" 2>/dev/null)" || {
    ui_err "could not copy '$name'"; return 1; }
  [ -n "$h" ] || { ui_err "could not copy '$name'"; return 1; }

  SEC_CLIP_HASH="$h"          # so quitting also clears it, not just the timer
  sec_log_start "copy"; sec_log "copy $name (ttl ${ttl}s)"
  ui_ok "'$name' is on the clipboard — clears in ${ttl}s"

  # detached clearer: only clears if the clipboard still holds our value
  (
    sleep "$ttl"
    cur="$($clip_get 2>/dev/null | shasum -a 256 | cut -d' ' -f1)"
    [ "$cur" = "$h" ] && printf '' | $clip_put
  ) >/dev/null 2>&1 &
  return 0
}

# --- guided rotation -----------------------------------------------------------
api_rotate() {
  local name="${1:-}"
  [ -n "$name" ] || name="$(api_pick)" || return 1
  [ -n "$name" ] || return 1
  sec_has "$name" || { ui_err "no such key: '$name'"; return 1; }

  ui_rule "Rotate $name"
  local prov perm res used exp created
  prov="$(sec_manifest_field "$name" provider)"
  perm="$(sec_manifest_field "$name" permissions)"
  res="$(sec_manifest_field "$name" resources)"
  used="$(sec_manifest_field "$name" used_by)"
  exp="$(sec_manifest_field "$name" expires)"
  created="$(sec_manifest_field "$name" created)"
  if [ -n "$prov$perm$res$used" ]; then
    printf '  %-13s %s\n' "provider"    "${prov:-—}"
    printf '  %-13s %s\n' "permissions" "${perm:-—}"
    printf '  %-13s %s\n' "resources"   "${res:-—}"
    printf '  %-13s %s\n' "used by"     "${used:-—}"
    printf '  %-13s %s\n' "created"     "${created:-—}"
    printf '  %-13s %s\n' "expires"     "${exp:-—}"
  else
    ui_warn "no manifest entry — you are rotating a credential with no record of what it permits"
    ui_note "run 'secrets manifest' afterwards to document it"
  fi
  echo

  if [ -f "$SEC_ROTATE" ] && grep -q "^- \[ \] $name\$" "$SEC_ROTATE"; then
    ui_warn "$name is on the exposure rotation worklist — rotating it clears that flag"
  fi

  ui_note "Create the replacement at the provider FIRST, then paste it here."
  ui_note "Do not revoke the old one until the new one is verified working."
  echo
  local val
  val="$(ui_ask_secret "New value for $name")" || return 1
  [ -n "$val" ] || { ui_warn "empty — nothing changed"; return 1; }

  sec_log_start "rotate"; sec_log "rotate $name"
  if sec_put "$name" "$val"; then
    unset val
    ui_ok "'$name' replaced in the store"
  else
    unset val; ui_err "failed to write '$name'"; return 1
  fi

  # stamp the manifest
  local today; today="$(date +%F)"
  if [ -f "$SEC_MANIFEST" ] && grep -qE "^$name:" "$SEC_MANIFEST"; then
    if grep -qE "^$name:" "$SEC_MANIFEST" && awk -v k="$name" '
        /^[A-Za-z_][A-Za-z0-9_]*:[[:space:]]*$/ { c=($1==k":") }
        c && /^[[:space:]]+rotated:/ { found=1 }
        END { exit !found }' "$SEC_MANIFEST"; then
      awk -v k="$name" -v d="$today" '
        /^[A-Za-z_][A-Za-z0-9_]*:[[:space:]]*$/ { c=($1==k":") }
        c && /^[[:space:]]+rotated:/ { print "  rotated:     " d; next }
        { print }' "$SEC_MANIFEST" > "$TMPD/man" && cat "$TMPD/man" > "$SEC_MANIFEST"
    else
      awk -v k="$name" -v d="$today" '
        { print }
        $0 == k":" { print "  rotated:     " d }' "$SEC_MANIFEST" > "$TMPD/man" && cat "$TMPD/man" > "$SEC_MANIFEST"
    fi
    ui_ok "manifest stamped rotated: $today"
  fi

  # clear the exposure flag
  if [ -f "$SEC_ROTATE" ] && grep -q "^- \[ \] $name\$" "$SEC_ROTATE"; then
    sed "s/^- \[ \] $name\$/- [x] $name  (rotated $today)/" "$SEC_ROTATE" > "$TMPD/rot" \
      && cat "$TMPD/rot" > "$SEC_ROTATE"
    local left; left="$(grep '^- \[ \]' "$SEC_ROTATE" | sec_nlines)"
    ui_ok "marked rotated on the exposure worklist — $left still pending"
  fi

  echo
  ui_warn "NOW revoke the OLD credential at ${prov:-the provider}. The store no longer has it."
}

# --- profiles ------------------------------------------------------------------
profile_names() {
  [ -f "$SEC_PROFILES" ] || return 0
  grep -oE '^[A-Za-z_][A-Za-z0-9_-]*:' "$SEC_PROFILES" 2>/dev/null | sed 's/:$//' | sort
}
profile_keys() { # $1 profile -> key names
  [ -f "$SEC_PROFILES" ] || return 0
  awk -v p="$1" '
    /^[A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ { c=($1==p":"); next }
    c && /^[[:space:]]*-[[:space:]]+/ { sub(/^[[:space:]]*-[[:space:]]+/,""); sub(/[[:space:]]*#.*$/,""); print }
    c && /^[A-Za-z_]/ { c=0 }
  ' "$SEC_PROFILES"
}

profile_cmd() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|"")
      [ -f "$SEC_PROFILES" ] || { ui_info "no profiles yet — create one with: secrets profile add NAME"; return 0; }
      ui_rule "Profiles"
      local p n
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        n="$(profile_keys "$p" | grep -c . )"
        printf '  %-22s %s keys\n' "$p" "$n"
      done <<EOF
$(profile_names)
EOF
      ;;
    show)
      local p="${1:-}"; [ -n "$p" ] || p="$(profile_names | ui_filter 'profile')"
      [ -n "$p" ] || return 1
      ui_rule "Profile: $p"
      profile_keys "$p" | sed 's/^/  /'
      ;;
    add)
      local p="${1:-}"
      [ -n "$p" ] || p="$(ui_ask 'Profile name' 'e.g. cloudflare')" || return 1
      [ -n "$p" ] || return 1
      printf '%s' "$p" | grep -qE '^[A-Za-z_][A-Za-z0-9_-]*$' || { ui_err "invalid profile name"; return 1; }
      ui_info "Pick the keys for this profile (tab marks, enter confirms)"
      local picked; picked="$(sec_names | ui_filter_multi "keys for profile '$p'")" || return 1
      [ -n "$picked" ] || { ui_warn "nothing picked"; return 1; }
      sec_log_start "profile"; sec_log "profile add $p"
      touch "$SEC_PROFILES"
      if grep -qE "^$p:" "$SEC_PROFILES" 2>/dev/null; then
        ui_err "profile '$p' already exists — remove it first"; return 1
      fi
      { echo "$p:"; printf '%s\n' "$picked" | sed 's/^/  - /'; echo ""; } >> "$SEC_PROFILES"
      ui_ok "profile '$p' saved with $(printf '%s\n' "$picked" | grep -c .) keys"
      ;;
    rm|remove)
      local p="${1:-}"; [ -n "$p" ] || p="$(profile_names | ui_filter 'profile to remove')"
      [ -n "$p" ] || return 1
      grep -qE "^$p:" "$SEC_PROFILES" 2>/dev/null || { ui_err "no such profile: $p"; return 1; }
      ui_confirm "Delete profile '$p'?" || { ui_info "kept"; return 0; }
      awk -v p="$p" '
        /^[A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ { c=($1==p":") }
        !c { print }
      ' "$SEC_PROFILES" > "$TMPD/prof" && cat "$TMPD/prof" > "$SEC_PROFILES"
      sec_log_start "profile"; sec_log "profile rm $p"
      ui_ok "removed profile '$p'"
      ;;
    *) ui_err "usage: secrets profile [list|show|add|rm] [NAME]"; return 1 ;;
  esac
}

# --- manifest + expiry ---------------------------------------------------------
do_manifest() {
  mkdir -p "$(dirname "$SEC_MANIFEST")"
  if [ ! -f "$SEC_MANIFEST" ]; then
    {
      echo "# CREDENTIALS.yaml — metadata for the SOPS store. NO SECRET VALUES."
      echo "# Safe to commit. 'secrets expiring' reads the expires: fields."
      echo "# Name credentials by purpose and trust boundary, never by resource."
      echo ""
    } > "$SEC_MANIFEST"
    ui_ok "created $SEC_MANIFEST"
  fi
  sec_log_start "manifest"
  local added=0 n
  while read -r n; do
    [ -n "$n" ] || continue
    if ! grep -qE "^$n:" "$SEC_MANIFEST" 2>/dev/null; then
      {
        echo "$n:"
        echo "  provider:    TODO"
        echo "  permissions: TODO"
        echo "  resources:   TODO"
        echo "  created:     TODO   # YYYY-MM-DD"
        echo "  expires:     TODO   # YYYY-MM-DD, or 'none' if it genuinely never expires"
        echo "  used_by:     TODO"
        echo ""
      } >> "$SEC_MANIFEST"
      added=$((added+1))
    fi
  done <<EOF
$(sec_names)
EOF
  ui_ok "manifest: $added new entries added ($SEC_MANIFEST)"
  sec_manifest_keys > "$TMPD/mkeys"; sec_names > "$TMPD/skeys"
  comm -13 "$TMPD/skeys" "$TMPD/mkeys" | while read -r s; do
    [ -n "$s" ] && ui_warn "documented but NOT in store: $s"
  done
  return 0
}

# Honest expiry. The old version returned a green "nothing expiring" while most
# keys had no expiry recorded at all. Unknown is now reported as unknown, and an
# all-clear is only possible at full coverage.
do_expiring() {
  local days="${1:-14}" now known=0 unknown=0 total=0
  [ -f "$SEC_MANIFEST" ] || sec_die "no manifest yet — run: secrets manifest"
  now="$(date +%s)"
  : > "$TMPD/exp"; : > "$TMPD/unknown"

  local n exp e left
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    total=$((total+1))
    exp="$(sec_manifest_field "$n" expires)"
    case "$exp" in
      none)      known=$((known+1)) ;;
      ""|TODO|*TODO*)
                 unknown=$((unknown+1)); printf '%s\n' "$n" >> "$TMPD/unknown" ;;
      *)
        e="$(sec_epoch_of "$exp")"
        if [ -z "$e" ]; then
          unknown=$((unknown+1)); printf '%s (unparseable: %s)\n' "$n" "$exp" >> "$TMPD/unknown"
        else
          known=$((known+1))
          left=$(( (e - now) / 86400 ))
          if   [ "$left" -lt 0 ]; then printf 'EXPIRED %s %s %s\n' "$n" "$exp" "$(( -left ))" >> "$TMPD/exp"
          elif [ "$left" -le "$days" ]; then printf 'SOON %s %s %s\n' "$n" "$exp" "$left" >> "$TMPD/exp"
          fi
        fi ;;
    esac
  done <<EOF
$(sec_names)
EOF

  ui_rule "Expiry — $days day window"
  if [ -s "$TMPD/exp" ]; then
    local state name ex num
    while read -r state name ex num; do
      if [ "$state" = EXPIRED ]; then
        printf '  \033[38;5;%sm EXPIRED \033[0m %-34s %s  (%s days ago)\n' "$UI_ERR" "$name" "$ex" "$num"
      else
        printf '  \033[38;5;%sm SOON    \033[0m %-34s %s  (in %s days)\n' "$UI_WARN" "$name" "$ex" "$num"
      fi
    done < "$TMPD/exp"
  else
    ui_info "no dated credential falls inside the window"
  fi

  echo
  local pct=0
  [ "$total" -gt 0 ] && pct=$(( known * 100 / total ))
  printf '  coverage: %s of %s credentials have a recorded expiry decision (%s%%)\n' "$known" "$total" "$pct"

  if [ "$unknown" -gt 0 ]; then
    ui_warn "$unknown credential(s) have NO expiry recorded — this report cannot clear them"
    if [ "${SEC_VERBOSE:-0}" = "1" ]; then
      sed 's/^/      /' "$TMPD/unknown"
    else
      head -8 "$TMPD/unknown" | sed 's/^/      /'
      [ "$unknown" -gt 8 ] && printf '      … and %s more (SEC_VERBOSE=1 to list all)\n' "$(( unknown - 8 ))"
    fi
    ui_note "fill them in: secrets manifest, then edit $(basename "$SEC_MANIFEST")"
  fi

  # Non-zero if anything is expiring OR if coverage is incomplete. A partial
  # picture is not an all-clear, and this is meant to gate a preflight.
  if [ -s "$TMPD/exp" ] || [ "$unknown" -gt 0 ]; then return 1; fi
  ui_ok "full coverage, nothing expiring within $days days"
  return 0
}

# =============================================================================
# DOCTOR
# =============================================================================
do_doctor() {
  local fails=0 warns=0
  ui_clear
  ui_panel "🩺  secrets doctor" "$(hostname -s) · $(date -u +%FT%TZ)"

  ui_rule "1 · Toolchain"
  if command -v sops >/dev/null 2>&1; then ui_ok "sops $(sops --version 2>/dev/null | head -1 | awk '{print $2}')"
  else ui_err "sops missing"; fails=$((fails+1)); fi
  if command -v age >/dev/null 2>&1; then ui_ok "age $(age --version 2>/dev/null)"
  else ui_warn "age binary missing (sops has it built in, but keygen needs it)"; warns=$((warns+1)); fi
  if command -v gum >/dev/null 2>&1; then ui_ok "gum $(gum --version 2>/dev/null | awk '{print $3}') — full visual layer"
  else ui_warn "gum missing — degraded to plain prompts"; warns=$((warns+1)); fi
  if sec_names_have_python; then ui_ok "python3 present (safe key enumeration)"
  else ui_err "python3 missing — enumeration would degrade"; fails=$((fails+1)); fi

  ui_rule "2 · Decryption"
  if [ -f "$SOPS_AGE_KEY_FILE" ]; then ui_ok "age key present at $SOPS_AGE_KEY_FILE"
  else ui_err "no age key at $SOPS_AGE_KEY_FILE"; fails=$((fails+1)); fi
  if api_check >/dev/null 2>&1; then ui_ok "store decrypts and the SOPS_SELFTEST canary reads 'ok'"
  else ui_err "store did NOT decrypt on this host"; fails=$((fails+1)); fi

  ui_rule "3 · Recipients"
  sec_config_recipients > "$TMPD/cfgrec"
  sec_file_recipients "$SEC_STORE" > "$TMPD/filerec"
  local nc nf
  nc="$(sec_nlines < "$TMPD/cfgrec")"; nf="$(sec_nlines < "$TMPD/filerec")"
  printf '  .sops.yaml declares : %s age recipients\n' "$nc"
  printf '  the store carries   : %s age recipients\n' "$nf"
  if [ "$nc" = "$nf" ] && [ -z "$(comm -3 "$TMPD/cfgrec" "$TMPD/filerec")" ]; then
    ui_ok "store recipients match .sops.yaml"
  else
    ui_err "DRIFT — store recipients differ from .sops.yaml; fix with: sops updatekeys $SEC_STORE"
    comm -23 "$TMPD/cfgrec" "$TMPD/filerec" | sed 's/^/      declared but not on the file: /'
    comm -13 "$TMPD/cfgrec" "$TMPD/filerec" | sed 's/^/      on the file but not declared: /'
    fails=$((fails+1))
  fi

  ui_rule "4 · Store integrity"
  local n; n="$(sec_count)"
  ui_ok "$n credentials enumerate cleanly"
  local ml; ml="$(sec_multiline_names 2>/dev/null | sec_nlines)"
  if [ "${ml:-0}" -gt 0 ]; then
    ui_warn "$ml value(s) contain newlines — enumeration is JSON-based so this is handled,"
    ui_warn "  but dotenv EDITING of those keys will mangle them. Prefer the certs/keys module."
    warns=$((warns+1))
  else
    ui_ok "no multi-line values (dotenv format is safe here)"
  fi

  ui_rule "5 · Documentation coverage"
  sec_manifest_keys > "$TMPD/mk"; sec_names > "$TMPD/sk"
  local undoc doc pct
  undoc="$(comm -23 "$TMPD/sk" "$TMPD/mk" | sec_nlines)"
  doc=$(( n - undoc )); pct=0; [ "$n" -gt 0 ] && pct=$(( doc * 100 / n ))
  printf '  documented: %s of %s (%s%%)\n' "$doc" "$n" "$pct"
  if [ "$undoc" -gt 0 ]; then ui_warn "$undoc credential(s) have no manifest entry"; warns=$((warns+1))
  else ui_ok "every credential is documented"; fi

  ui_rule "6 · Expiry"
  # do_expiring calls sec_die when there is no manifest, which would exit the
  # whole program mid-report. A health check must survive an unhealthy store.
  if [ ! -f "$SEC_MANIFEST" ]; then
    ui_warn "no credential manifest yet — run: secretsd manifest"; warns=$((warns+1))
  elif ( do_expiring 14 >/dev/null 2>&1 ); then
    ui_ok "full expiry coverage, nothing due within 14 days"
  else
    ui_warn "expiry report is not clear — run: secretsd expiring"; warns=$((warns+1))
  fi

  ui_rule "7 · Plaintext hygiene"
  local stray=0 f
  for f in "$SEC_SECRETS"/* "$SEC_SECRETS"/.[!.]*; do
    [ -f "$f" ] || continue
    case "$f" in *.enc.env|*.enc.yaml|*.enc.json|*.md|*.yaml|*.bak-*|*.selftest-only.bak) continue ;; esac
    if [ -s "$f" ] && ! grep -q 'sops_' "$f" 2>/dev/null && grep -qE '^[A-Za-z_][A-Za-z0-9_]*=' "$f" 2>/dev/null; then
      ui_err "PLAINTEXT credential file: $f"; stray=$((stray+1)); fails=$((fails+1))
    fi
  done
  [ "$stray" -eq 0 ] && ui_ok "no plaintext credential files in secrets/"

  # A sync tool that copies your data root somewhere else is the single most
  # common way an encrypted store ends up somewhere it should not be. If the data
  # root is inside a directory that something else mirrors, say so — generically,
  # because we cannot know what you use.
  if [ -d "$SEC_ROOT/.git" ] || git -C "$SEC_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if git -C "$SEC_ROOT" check-ignore -q secrets 2>/dev/null; then
      ui_ok "the data root is under git, and secrets/ is ignored"
    else
      ui_err "the data root is under git and secrets/ is NOT ignored"
      ui_note "add 'secrets/' to .gitignore before you ever commit"
    fi
  else
    ui_ok "the data root is not a git repository"
  fi
  case "$SEC_ROOT" in
    "$HOME"/Dropbox/*|"$HOME"/Library/CloudStorage/*|"$HOME"/"Google Drive"/*|*/iCloud*/*)
      ui_warn "the data root sits inside a cloud-synced folder"
      ui_note "encrypted blobs stay encrypted, but the sync provider gets a copy of everything"
      ;;
  esac

  if [ -f "$SEC_ROTATE" ]; then
    local pending; pending="$(grep '^- \[ \]' "$SEC_ROTATE" | sec_nlines)"
    if [ "$pending" -gt 0 ]; then ui_warn "$pending credential(s) pending rotation after exposure"; warns=$((warns+1))
    else ui_ok "exposure rotation worklist is fully cleared"; fi
  fi

  ui_rule "8 · Housekeeping"
  local nlogs sz
  nlogs="$(find "$SEC_ROOT/run-logs" -maxdepth 1 -type f -name '*.log' 2>/dev/null | wc -l | tr -d ' ')"
  sz="$(du -sh "$SEC_ROOT/run-logs" 2>/dev/null | awk '{print $1}')"
  printf '  run-logs: %s files, %s\n' "${nlogs:-0}" "${sz:-0}"
  if [ "${nlogs:-0}" -gt 1000 ]; then ui_warn "run-logs is large — prune with: secrets logs prune"; warns=$((warns+1))
  else ui_ok "run-log volume is sane"; fi

  ui_rule "Verdict"
  if [ "$fails" -gt 0 ]; then
    ui_err "$fails failure(s), $warns warning(s) — this store is NOT healthy"
    return 1
  elif [ "$warns" -gt 0 ]; then
    ui_warn "0 failures, $warns warning(s) — working, with gaps worth closing"
    return 0
  fi
  ui_ok "all checks pass"
  return 0
}

# =============================================================================
# API MODULE MENU
# =============================================================================
api_menu() {
  local choice n
  while :; do
    TUI_MENU_ICON="api"
    choice="$(tui_menu "API MANAGEMENT" "$(sec_count) credentials · $(hostname -s)" \
      "Browse credentials|every credential with its provider and expiry" \
      "Find a credential (fuzzy)|type to narrow the list, then act on one" \
      "Add credentials|hidden input, loops so you can add several" \
      "Rotate a credential|guided: shows what it permits, stamps the date" \
      "Copy a value to the clipboard|clipboard only, clears itself after 45s" \
      "Run a command with secrets injected|values exist only inside the child process" \
      "Profiles|named bundles you can inject with --profile" \
      "Remove a credential|pick from the list, then confirm" \
      "Documentation + expiry|coverage report and what expires soon" \
      "Edit the raw store|opens the encrypted file in your editor" \
      "Back|return to the dashboard")" || break
    case "$choice" in
      "Browse credentials")   api_browse; ui_pause ;;
      "Find a credential"*)   n="$(api_pick)"; [ -n "$n" ] && { key_actions "$n"; } ;;
      "Add credentials")      api_add_loop; ui_pause ;;
      "Rotate a credential")  api_rotate; ui_pause ;;
      "Copy a value"*)        api_copy; ui_pause ;;
      "Run a command"*)
        local c; c="$(ui_ask 'Command (reads $YOUR_KEY from env)' 'curl -H "Authorization: Bearer $XAI_API_01" ...')" || continue
        [ -n "$c" ] && { sec_log_start "run"; sec_log "menu run"; sops exec-env "$SEC_STORE" "$c"; ui_pause; } ;;
      "Profiles")             profile_cmd list; ui_pause ;;
      "Remove a credential")
        n="$(api_pick)" || continue
        [ -n "$n" ] || continue
        if ui_confirm "Delete '$n'?"; then
          sec_log_start "rm"; sec_log "rm $n"
          sec_unset "$n" && ui_ok "removed '$n'" || ui_err "could not remove '$n'"
        else ui_info "nothing removed"; fi
        ui_pause ;;
      "Documentation + expiry") do_expiring 14; ui_pause ;;
      "Edit the raw store")   api_edit ;;
      "Back"|"")              break ;;
    esac
  done
}

key_actions() { # $1 key name
  local n="$1" a prov exp used rot sub
  while :; do
    prov="$(sec_manifest_field "$n" provider)"; [ -n "$prov" ] || prov="undocumented"
    exp="$(sec_manifest_field "$n" expires)";   [ -n "$exp" ]  || exp="—"
    used="$(sec_manifest_field "$n" used_by)";  [ -n "$used" ] || used="—"
    rot="$(sec_manifest_field "$n" rotated)";   [ -n "$rot" ]  || rot="never"
    sub="$prov · expires $exp · rotated $rot · used by $used"
    TUI_MENU_ICON="api"
    a="$(tui_menu "$n" "$sub" \
      "Copy to clipboard|value goes to the clipboard and clears after 45s" \
      "Rotate this credential|replace the value, stamp the manifest" \
      "Run a command with it|inject only this key into one command" \
      "Remove it|delete this credential from the store" \
      "Back|return to the credential list")" || break
    case "$a" in
      "Copy to clipboard")   api_copy "$n"; ui_pause ;;
      "Rotate this"*)        api_rotate "$n"; ui_pause ;;
      "Run a command"*)
        local c; c="$(ui_ask "Command (reads \$$n)" "")" || continue
        [ -n "$c" ] && { sec_log_start "run"; sops exec-env "$SEC_STORE" "$c"; ui_pause; } ;;
      "Remove it")
        ui_confirm "Delete '$n'?" && { sec_log_start "rm"; sec_log "rm $n"; sec_unset "$n" && ui_ok "removed"; break; } ;;
      "Back"|"") break ;;
    esac
  done
}

# =============================================================================
# DISPATCH
# =============================================================================
sec_require_sops
sec_enforce_scratch
sec_enforce_all

cmd="${1:-}"; shift 2>/dev/null || true

case "$cmd" in
  # ---- module entry points --------------------------------------------------
  api|pii|keys|auth|machines|certs|env|dns|logins)
    if [ $# -eq 0 ]; then module_open "$cmd"
    else ui_err "module '$cmd' takes no subcommands yet"; exit 1; fi ;;

  # ---- API module, top level (backward compatible) --------------------------
  add)
    if [ -n "${1:-}" ]; then sec_log_start "add"; api_add_one "$1"
    elif ui_interactive; then api_add_loop
    else sec_die "interactive add needs a terminal — use: secrets add NAME (value on stdin)"; fi ;;

  rm|remove|del)
    name="${1:-}"
    if [ -z "$name" ]; then
      ui_interactive || sec_die "usage: secrets rm NAME"
      name="$(api_pick)" || exit 1
      [ -n "$name" ] || exit 1
      ui_confirm "Delete '$name'?" || { ui_info "nothing removed"; exit 0; }
    fi
    sec_log_start "rm"; sec_log "rm $name"
    if sec_unset "$name"; then ui_ok "removed '$name'"
    else sec_die "could not remove '$name' (does it exist?) — see $SEC_LOG"; fi ;;

  run)
    only=""; aliases=""; profile=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --only)    shift; [ $# -gt 0 ] || sec_die "--only needs NAME[,NAME...]"; only="$only,$1"; shift ;;
        --as)      shift; [ $# -gt 0 ] || sec_die "--as needs SRC=DST"; aliases="$aliases $1"; shift ;;
        --profile) shift; [ $# -gt 0 ] || sec_die "--profile needs a NAME"; profile="$1"; shift ;;
        --)        shift; break ;;
        *)         sec_die "usage: secrets run [--only NAME[,NAME]] [--as SRC=DST] [--profile NAME] -- <command> [args]" ;;
      esac
    done
    [ $# -gt 0 ] || sec_die "no command given after --"

    if [ -n "$profile" ]; then
      profile_names | grep -qx "$profile" || sec_die "no such profile '$profile' — see: secrets profile list"
      pk="$(profile_keys "$profile")"
      [ -n "$pk" ] || sec_die "profile '$profile' is empty"
      while IFS= read -r k; do [ -n "$k" ] && only="$only,$k"; done <<EOF
$pk
EOF
    fi

    prelude=""; keep=","; alias_dsts=","
    for m in $aliases; do
      src="${m%%=*}"; dst="${m#*=}"
      [ "$src" != "$m" ] || sec_die "--as expects SRC=DST, got '$m'"
      sec_valid_name "$src" || sec_die "--as: invalid source name '$src'"
      sec_valid_name "$dst" || sec_die "--as: invalid destination name '$dst'"
      sec_has "$src"  || sec_die "--as: '$src' is not in the store"
      prelude="$prelude$dst=\"\$$src\"; export $dst; "
      keep="$keep$dst,"; alias_dsts="$alias_dsts$dst,"
    done

    if [ -n "$only" ]; then
      _ifs="$IFS"; IFS=','
      for n in $only; do
        [ -n "$n" ] || continue
        sec_valid_name "$n" || { IFS="$_ifs"; sec_die "--only: invalid name '$n'"; }
        if ! sec_has "$n"; then
          case "$alias_dsts" in
            *",$n,"*) ;;
            *) IFS="$_ifs"; sec_die "--only: '$n' is neither a store key nor an --as destination" ;;
          esac
        fi
        keep="$keep$n,"
      done
      IFS="$_ifs"
      while read -r n; do
        [ -n "$n" ] || continue
        case "$keep" in *",$n,"*) ;; *) prelude="$prelude unset $n; " ;; esac
      done <<EOF
$(sec_names)
EOF
    fi

    cmdq=""
    for a in "$@"; do cmdq="$cmdq$(printf '%q ' "$a")"; done
    sec_log_start "run"
    sec_log "run: $1 ($# args, only='${only#,}', as='${aliases# }', profile='$profile')"
    exec sops exec-env "$SEC_STORE" "$prelude exec $cmdq" ;;

  pick)
    ui_interactive || sec_die "pick needs a terminal"
    n="$(api_pick)" || exit 1
    [ -n "$n" ] && key_actions "$n" ;;

  copy)
    name=""; ttl=45
    while [ $# -gt 0 ]; do
      case "$1" in
        --ttl) shift; [ $# -gt 0 ] || sec_die "--ttl needs seconds"
               case "$1" in ''|*[!0-9]*) sec_die "--ttl must be a number" ;; esac
               ttl="$1"; shift ;;
        *)     name="$1"; shift ;;
      esac
    done
    api_copy "$name" "$ttl" ;;

  rotate)  api_rotate "${1:-}" ;;
  profile) profile_cmd "$@" ;;
  edit)    api_edit ;;
  names|ls|list) sec_names ;;
  check)   api_check ;;
  doctor)  do_doctor ;;
  manifest) do_manifest ;;

  expiring)
    d="14"
    if [ "${1:-}" = "--days" ]; then
      shift; [ $# -gt 0 ] || sec_die "--days needs a number"
      case "$1" in ''|*[!0-9]*) sec_die "--days must be a number, got '$1'" ;; esac
      d="$1"
    fi
    do_expiring "$d" ;;

  logs)
    case "${1:-}" in
      prune)
        shift
        keep="${1:-400}"
        case "$keep" in ''|*[!0-9]*) sec_die "usage: secrets logs prune [KEEP]" ;; esac
        removed="$(sec_log_prune "$keep")"
        ui_ok "pruned $removed log file(s); kept the $keep most recent" ;;
      *) sec_die "usage: secrets logs prune [KEEP]" ;;
    esac ;;

  menu|"")
    if ui_interactive; then
      [ -f "$SEC_PKM" ] || pkm_screen
      home_screen
    else sec_help; fi ;;
  home)         home_screen ;;
  posture)      posture_screen ;;
  gen|generate) gen_screen ;;
  find|search)  palette_screen ;;
  totp)         totp_cmd "$@" ;;
  yubikey|yk)   yubikey_screen ;;
  audit|trail)  audit_screen ;;
  keys-help|\?) help_screen ;;
  vaults|vault) vault_screen ;;
  pkm)          pkm_screen ;;
  inbox)        inbox_screen ;;
  workspace|work|code) ws_screen ;;
  sessions)     ws_sessions_screen ;;
  adopt)        ws_adopt_screen ;;
  import)       import_screen ;;
  broker|merge) broker_screen ;;
  janitor)      janitor_screen ;;
  profiles|crew) profiles_screen ;;
  recovery|kit) recovery_screen ;;
  monitor)
    if [ "${1:-}" = "--sweep" ]; then
      shift; mon_sweep "${1:-10}" 1
    else monitor_screen; fi ;;
  guard)
    if [ -n "${1:-}" ]; then
      d="${1/#\~/$HOME}"
      guard_install "$d" && { ui_ok "hook installed in $d"; guard_selftest "$d"; }
    else guard_screen; fi ;;
  record)       prov_record "$@" ;;
  -h|--help|help) sec_help ;;
  *) sec_die "unknown subcommand '$cmd' — try: secrets help" ;;
esac
